# ─────────────────────────────────────────────────────────────────
# Credentials PISTE (portail API DGFiP pour Chorus Pro)
# Obtenir un compte sur : https://developer.aife.economie.gouv.fr/
# ─────────────────────────────────────────────────────────────────

# OAuth2 PISTE — récupérés dans votre application PISTE
CHORUS_CLIENT_ID=votre_client_id_ici
CHORUS_CLIENT_SECRET=votre_client_secret_ici

# Identifiants Chorus Pro (espace fournisseur)
CHORUS_LOGIN=votre.email@entreprise.fr
CHORUS_PASSWORD=votre_mot_de_passe_chorus

# Environnement : sandbox | production
CHORUS_ENV=sandbox
